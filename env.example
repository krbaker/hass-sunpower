# SunPower PVS Configuration
# Copy this file to .env and update with your settings

# PVS Host IP Address
# This is typically 172.27.153.1 for NAT setup or your PVS's actual IP
PVS_HOST=172.27.153.1

# Optional: Custom name for your installation
PVS_NAME="My Solar System"

# Debug logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Home Assistant configuration (if testing with HA)
HA_CONFIG_DIR=/config

# Test configuration
PYTEST_TIMEOUT=120
